# 复制成 .env 后修改（docker compose 会自动读取同目录的 .env）
#
# 群晖路径示例：DATA_DIR=/volume1/docker/wxip/data
# 普通 Linux 示例：DATA_DIR=/opt/wecom-trusted-ip/data

# 【必改】面板会话签名密钥，生成方式：openssl rand -hex 32
APP_SECRET_KEY=

# 【必改】镜像地址：改成你自己构建并推送的镜像，例如 yourname/wxip:latest
IMAGE=YOUR_DOCKERHUB/wxip:latest

# 监听地址：走反向代理填 127.0.0.1，直接 IP 访问填 0.0.0.0
PANEL_BIND=0.0.0.0

# 数据目录（宿主机路径，数据库与企业微信登录态都放这里）
DATA_DIR=./data

# 自动同步间隔（秒）与开关
APP_SYNC_INTERVAL_SECONDS=300
APP_AUTO_SYNC_ENABLED=true

TZ=Asia/Shanghai
