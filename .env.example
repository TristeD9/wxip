# 面板会话签名密钥，部署前必须换成随机字符串
APP_SECRET_KEY=change-me-to-a-random-string

# 运行数据目录：SQLite 数据库与企业微信登录态都放在这里
APP_DATA_DIR=./data

# 自动同步
APP_AUTO_SYNC_ENABLED=true
APP_SYNC_INTERVAL_SECONDS=300

# 浏览器自动化
APP_BROWSER_HEADLESS=true
# 留空使用 Playwright 自带 Chromium；本机调试可填 chrome 或 msedge
APP_BROWSER_CHANNEL=
APP_BROWSER_TIMEOUT_MS=45000

# 前后端分开部署时的允许来源，JSON 数组格式
APP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

APP_LOG_LEVEL=INFO

# 以下变量供 compose.yaml 使用（docker compose 会自动读取本文件）
# 镜像地址：改成你自己的（Docker Hub 用户名/仓库名），例如 yourname/wxip:latest
IMAGE=YOUR_DOCKERHUB/wxip:latest
# 面板监听地址：对公网开放用 0.0.0.0，走 Nginx/宝塔反代时建议改成 127.0.0.1
PANEL_BIND=0.0.0.0
# 数据目录（SQLite、企业微信登录态、调试文件）
DATA_DIR=./data
TZ=Asia/Shanghai

# 注意：APP_BROWSER_CHANNEL 只用于本机直接运行（填 chrome/msedge），
# 容器内 compose.yaml 已固定为空，会使用镜像自带的 Chromium。

